# Copy to .env.local for `npm run dev`, and set the same names in Vercel → Settings → Environment Variables.
APP_PASSCODE=

# Gemini (free tier). AI_MODEL is optional; the default is gemini-3.5-flash-lite.
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Or Anthropic: AI_PROVIDER=anthropic with ANTHROPIC_API_KEY (default model claude-haiku-4-5).
# Or OpenAI: AI_PROVIDER=openai with OPENAI_API_KEY.
ANTHROPIC_API_KEY=
AI_MODEL=
